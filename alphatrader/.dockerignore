# .dockerignore
# Excludes files that should NOT be copied into Docker images.
# Keeps build context small and prevents secrets leaking into images.

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/

# Secrets — never bake into image
.env

# Dev tools
.git/
.gitignore
*.md

# Test files
tests/
*.test.py

# IDE
.vscode/
.idea/

# Logs
*.log
